#!/bin/sh
# PID 1 inside the UML guest.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
hostname uml

# RUN mode (see /uml/bin/run): execute the instruction, hand its status to
# UML as the container's exit code, and power off.
if [ -n "$run" ]; then
    sh -c "$(cat "$run")"
    echo $? > /proc/exitcode
    poweroff -f
fi

echo
echo "=== Hello from a Linux kernel running as a process inside Docker ==="
echo
echo "--- uname -a"
uname -a
echo
echo "--- /proc/cpuinfo (UML reports itself, not the real CPU)"
grep -E '^(vendor_id|model name|mode|host)' /proc/cpuinfo
echo
echo "--- memory the guest kernel manages (mem= on its command line)"
free -m
echo
echo "--- root filesystem (hostfs: the container's /uml/rootfs directory)"
mount | grep ' / '
echo
echo "--- guest process table (this kernel's own PIDs)"
ps
echo
echo "--- kernel command line"
cat /proc/cmdline
echo

if [ "$shell" = "1" ]; then
    echo "Dropping to a shell. 'poweroff -f' to exit."
    exec setsid cttyhack sh
fi

echo "Powering off."
poweroff -f
