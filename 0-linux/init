#!/bin/sh
# PID 1 inside the UML guest: runs the command /uml/bin/run handed over in the
# file named by $run, hands its status to UML as the container's exit code,
# and powers off — if PID 1 ever exits, the kernel panics instead. The kernel
# has already mounted /dev (CONFIG_DEVTMPFS_MOUNT).
mount -t proc proc /proc
mount -t sysfs sysfs /sys
hostname uml

# With a terminal attached (runtty=1) the command gets the console as its
# controlling tty, so job control and ^C work; without one its stdin is
# /dev/null, as in any other container — reading the input-less console would
# block forever instead of hitting EOF. Not with &: a background command
# starts with SIGINT ignored, and every child inherits that, so ^C would stop
# working.
if [ "$runtty" = 1 ]; then
    setsid cttyhack sh -c "$(cat "$run")"
else
    sh -c "$(cat "$run")" < /dev/null
fi
echo $? > /proc/exitcode
poweroff -f
