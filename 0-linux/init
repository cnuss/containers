#!/uml/bin/busybox sh
# PID 1 inside the UML guest: runs the script /uml/bin/run handed over in
# $run, hands its status to UML as the container's exit code, and powers off
# — if PID 1 ever exits, the kernel panics instead. The kernel has already
# mounted /dev (CONFIG_DEVTMPFS_MOUNT). Everything goes through the image's
# own busybox, so a guest that replaces /bin can't break booting.
bb=/uml/bin/busybox
$bb mount -t proc proc /proc
$bb mount -t sysfs sysfs /sys
$bb hostname -F /etc/hostname 2>/dev/null || $bb hostname uml

# The guest's root is the container's, where every command in /bin, and
# /usr/bin/env, is a symlink leading back into /uml/bin/run. Inside the guest,
# make that BusyBox — which picks the applet from the name it was run as — so
# they are the real thing here, in a guest-only mount the container never
# sees.
$bb mount --bind $bb /uml/bin/run

# vec0 leads to /uml/bin/run's gvproxy, which serves 192.168.127.0/24 with
# itself at .1. Name lookups go to it too, since it resolves the way the
# container does: a loopback nameserver in the container's resolv.conf, like
# Docker's 127.0.0.11, would be the guest's own loopback. The guest's
# resolv.conf is a guest-only mount, like /uml/bin/run's.
$bb ip link set lo up
if [ -e /sys/class/net/vec0 ]; then
    $bb ip link set vec0 up
    $bb ip addr add 192.168.127.2/24 dev vec0
    $bb ip route add default via 192.168.127.1
    if [ -f /etc/resolv.conf ]; then
        $bb mount -t tmpfs -o size=64k tmpfs /uml/etc
        {
            $bb grep -v '^nameserver' /etc/resolv.conf
            echo nameserver 192.168.127.1
        } > /uml/etc/resolv.conf
        $bb mount --bind /uml/etc/resolv.conf /etc/resolv.conf
    fi
fi

# With a terminal attached (runtty=1) the command gets the console as its
# controlling tty, so job control and ^C work; without one its stdin is
# /dev/null, as in any other container — reading the input-less console would
# block forever instead of hitting EOF — and its stdout and stderr are the
# consoles wired to the container's (/dev/console and /dev/tty1), with no
# \n -> \r\n translation, which only a terminal wants. Not with &: a
# background command starts with SIGINT ignored, and every child inherits
# that, so ^C would stop working.
if [ "$runtty" = 1 ]; then
    $bb setsid $bb cttyhack $bb sh "$run"
else
    $bb stty -onlcr
    $bb stty -onlcr < /dev/tty1
    $bb sh "$run" < /dev/null 2> /dev/tty1
fi
echo $? > /proc/exitcode
# The console is the command's stdout: keep "reboot: Power down" off it
echo 0 > /proc/sys/kernel/printk
$bb poweroff -f
