@@ -12,6 +12,7 @@
  * @returns a struct lkl_netdev_linux_fdnet entry for virtio-net
  */
 struct lkl_netdev *lkl_register_netdev_fd(int fd_rx, int fd_tx);
+struct lkl_netdev *lkl_register_netdev_fd_framed(int fd_rx, int fd_tx);
 
 
 /**
diff -ruN a/tools/lkl/lib/virtio_net_pipe.c b/tools/lkl/lib/virtio_net_pipe.c
--- a/tools/lkl/lib/virtio_net_pipe.c	2026-10-12 12:57:12
+++ b/tools/lkl/lib/virtio_net_pipe.c	2026-10-12 12:58:58
@@ -73,3 +73,45 @@
 	nd->has_vnet_hdr = 1;
 	return nd;
 }
+
+struct lkl_netdev *lkl_netdev_fifo_create(const char *_ifname)
+{
+	struct lkl_netdev *nd;
+	int fd_rx, fd_tx;
+	char *ifname = strdup(_ifname), *ifname_rx, *ifname_tx;
+
+	if (!ifname)
+		return NULL;
+	ifname_rx = strtok(ifname, "|");
+	ifname_tx = ifname_rx ? strtok(NULL, "|") : NULL;
+	if (!ifname_tx || strtok(NULL, "|")) {
+		fprintf(stderr, "invalid ifname format: %s\n", _ifname);
+		free(ifname);
+		return NULL;
+	}
+
+	fd_rx = open(ifname_rx, O_RDWR | O_NONBLOCK);
+	if (fd_rx < 0) {
+		perror("can not open ifname_rx fifo");
+		free(ifname);
+		return NULL;
+	}
+	fd_tx = open(ifname_tx, O_RDWR | O_NONBLOCK);
+	if (fd_tx < 0) {
+		perror("can not open ifname_tx fifo");
+		close(fd_rx);
+		free(ifname);
+		return NULL;
+	}
+	free(ifname);
+
+	nd = lkl_register_netdev_fd_framed(fd_rx, fd_tx);
+	if (!nd) {
+		close(fd_rx);
+		close(fd_tx);
+		return NULL;
+	}
+	/* Plain Ethernet frames: the other end needn't know virtio */
+	nd->has_vnet_hdr = 0;
+	return nd;
+}
